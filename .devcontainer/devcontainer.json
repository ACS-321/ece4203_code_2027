{
    "name": "Cal Poly ECE4203 2027",
    // Built from ../Dockerfile + build/devcontainer.json by .github/workflows/image.yml.
    // The desktop (desktop-lite), sshd, VNC password and remoteUser are baked into
    // the image metadata. Pinned to an exact release so the environment does not change
    // mid-term; to ship a fix, tag v2027.1.1 and bump this line (see docs/image.md).
    "image": "ghcr.io/dvanblerkom/ece4203:v2027.1.0",
    "hostRequirements": {
        "cpus": 2,
        "memory": "8gb",
        "storage": "32gb"
    },
    "forwardPorts": [6080, 5901],
    "portsAttributes": {
        "6080": {
            "label": "Desktop (noVNC)",
            "onAutoForward": "openBrowserOnce"
        },
        "5901": {
            "label": "VNC (native client)",
            "onAutoForward": "silent"
        }
    },
    // Idempotent: checks that the desktop is up (repairing it if needed) and
    // logs to ~/.cache/ece4203-desktop/desktop.log.
    "postStartCommand": "bash \"${containerWorkspaceFolder}/scripts/desktop.sh\" ensure",
    "remoteUser": "user",
    "customizations": {
        "vscode": {
            "extensions": [
                "mshr-h.veriloghdl",
                "leafvmaple.verilog-formatter"
            ]
        },
        "codespaces": {
            "idleTimeoutMinutes": 15
        }
    }
}
